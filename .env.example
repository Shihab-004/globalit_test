# Email service to use. Currently supports: "resend"
EMAIL_SERVICE=resend

# The API key for your email service (e.g. Resend API key from resend.com)
EMAIL_API_KEY=your_email_api_key_here

# The verified "from" email address on your email service domain
EMAIL_USER=noreply@globalit.technology

# Where to send enquiries (defaults to info@globalit.technology if not set)
EMAIL_TO=info@globalit.technology
